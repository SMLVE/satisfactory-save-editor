<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SatisfactorySaveEditor.App.ViewModels.Map"
             xmlns:views="using:SatisfactorySaveEditor.App.Views"
             xmlns:controls="using:SatisfactorySaveEditor.App.Controls"
             x:Class="SatisfactorySaveEditor.App.Views.MapView"
             x:DataType="vm:MapViewModel">

  <Grid ColumnDefinitions="*,4,620" Margin="8">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding SearchText}" Watermark="Search name or item (e.g. Motor)…" Width="300" />
          <Button Content="Fit all" Click="OnFitClick" />
          <TextBlock Text="{Binding Summary}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Layers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MapLayer">
              <CheckBox IsChecked="{Binding IsVisible}" Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="Scroll to zoom, drag to pan, click a marker to inspect it. Foundations and walls are not shown yet." />
      <controls:MapControl x:Name="Map" Markers="{Binding VisibleMarkers}" SelectedMarker="{Binding SelectedMarker}" />
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

    <Panel Grid.Column="2" Margin="8,0,0,0">
      <TextBlock Text="Click a marker on the map." Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !HasSelection}" />

      <DockPanel IsVisible="{Binding HasSelection}">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10" IsVisible="{Binding Player, Converter={x:Static ObjectConverters.IsNull}}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}" Classes="heading" />
            <Button Grid.Column="1" Content="Delete…" Command="{Binding DeleteSelectedCommand}" />
          </Grid>
          <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="This object has no inventory." Classes="muted" Margin="0,8,0,0" IsVisible="{Binding HasNoInventory}" />
        </StackPanel>
        <Panel>
          <Panel IsVisible="{Binding Player, Converter={x:Static ObjectConverters.IsNotNull}}">
            <views:PlayerView DataContext="{Binding Player}" />
          </Panel>
          <Panel IsVisible="{Binding Inventory, Converter={x:Static ObjectConverters.IsNotNull}}">
            <views:InventoryEditorView DataContext="{Binding Inventory}" />
          </Panel>
        </Panel>
      </DockPanel>
    </Panel>
  </Grid>
</UserControl>
