<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SatisfactorySaveEditor.App.ViewModels.Map"
             xmlns:views="using:SatisfactorySaveEditor.App.Views"
             xmlns:controls="using:SatisfactorySaveEditor.App.Controls"
             x:Class="SatisfactorySaveEditor.App.Views.MapView"
             x:DataType="vm:MapViewModel">

  <Grid ColumnDefinitions="*,4,620" Margin="8">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding SearchText}" Watermark="Search name or item (e.g. Motor)…" Width="300" />
          <Button Content="Fit all" Click="OnFitClick" />
          <TextBlock Text="{Binding Summary}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Layers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MapLayer">
              <CheckBox IsChecked="{Binding IsVisible}" Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <CheckBox IsChecked="{Binding ShowPowerLines}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="14" Height="2" Background="{Binding PowerLinesBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PowerLinesLabel}" />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding ShowStructures}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" Background="{Binding StructuresBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StructuresLabel}" />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="Scroll to zoom, drag to pan, click a marker to inspect it, Shift+drag to select an area." />
      <controls:MapControl x:Name="Map" Markers="{Binding VisibleMarkers}" SelectedMarker="{Binding SelectedMarker}"
                           Lines="{Binding VisibleLines}" Structures="{Binding VisibleStructures}"
                           BoxMarkers="{Binding BoxMarkers}" BoxStructures="{Binding BoxStructures}" />
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

    <Panel Grid.Column="2" Margin="8,0,0,0">
      <TextBlock Text="Click a marker on the map, or Shift+drag to select an area." Classes="muted"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowNothingSelected}" />

      <!-- Box selection -->
      <DockPanel IsVisible="{Binding HasBoxSelection}">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Selection" Classes="heading" />
            <Button Grid.Column="1" Content="Delete selected…" Command="{Binding DeleteBoxSelectionCommand}" />
            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearBoxSelectionCommand}" />
          </Grid>

          <StackPanel Spacing="6" IsVisible="{Binding BoxHasStructures}">
            <TextBlock Text="Move foundations &amp; walls (metres; 8 m = one foundation)" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding MoveX}" Width="80" Watermark="X" />
              <TextBox Text="{Binding MoveY}" Width="80" Watermark="Y" />
              <TextBox Text="{Binding MoveZ}" Width="80" Watermark="Z (up)" />
              <Button Content="Move" Command="{Binding MoveStructuresCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Only foundations, walls, ramps and walkways move. Machines, belts and other buildings stay where they are." />
          </StackPanel>
          <TextBlock Text="{Binding BoxMessage}" TextWrapping="Wrap" Classes.error="{Binding BoxMessageIsError}"
                     IsVisible="{Binding BoxMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="Selected" FontWeight="SemiBold" />
        </StackPanel>
        <ListBox ItemsSource="{Binding BoxSummary}" FontSize="12">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel IsVisible="{Binding HasSelection}">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10" IsVisible="{Binding Player, Converter={x:Static ObjectConverters.IsNull}}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}" Classes="heading" />
            <Button Grid.Column="1" Content="Delete…" Command="{Binding DeleteSelectedCommand}" />
          </Grid>
          <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="This object has no inventory." Classes="muted" Margin="0,8,0,0" IsVisible="{Binding HasNoInventory}" />
          <StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding IsBelt}">
            <TextBlock Text="On this belt" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding BeltContents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding HasPowerConnections}">
            <TextBlock Text="Power lines" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding PowerConnections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
        <Panel>
          <Panel IsVisible="{Binding Player, Converter={x:Static ObjectConverters.IsNotNull}}">
            <views:PlayerView DataContext="{Binding Player}" />
          </Panel>
          <Panel IsVisible="{Binding Inventory, Converter={x:Static ObjectConverters.IsNotNull}}">
            <views:InventoryEditorView DataContext="{Binding Inventory}" />
          </Panel>
        </Panel>
      </DockPanel>
    </Panel>
  </Grid>
</UserControl>
