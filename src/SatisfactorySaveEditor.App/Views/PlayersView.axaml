<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SatisfactorySaveEditor.App.ViewModels.Players"
             xmlns:views="using:SatisfactorySaveEditor.App.Views"
             x:Class="SatisfactorySaveEditor.App.Views.PlayersView"
             x:DataType="vm:PlayersViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="70" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="260,4,*" Margin="8">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Players" Classes="heading" Margin="0,0,0,6" />
      <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Names are not stored in saves; players are shown by platform id." />
      <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PlayerViewModel">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

    <ContentControl Grid.Column="2" Content="{Binding SelectedPlayer}" Margin="8,0,0,0">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:PlayerViewModel">
          <Panel>
            <TextBlock Text="This player has no character in the save." Classes="muted"
                       IsVisible="{Binding !HasPawn}" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <DockPanel IsVisible="{Binding HasPawn}">
              <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="{Binding Name}" Classes="heading" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Health" Classes="label" />
                  <TextBox Text="{Binding HealthText}" Width="90" />
                  <Button Content="Apply" Command="{Binding ApplyHealthCommand}" />
                  <TextBlock Text="0–100" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Position" Classes="label" />
                  <TextBox Text="{Binding PositionX}" Width="110" Watermark="X" />
                  <TextBox Text="{Binding PositionY}" Width="110" Watermark="Y" />
                  <TextBox Text="{Binding PositionZ}" Width="110" Watermark="Z" />
                  <Button Content="Apply" Command="{Binding ApplyPositionCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           Classes.error="{Binding MessageIsError}"
                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>

              <views:InventoryEditorView DataContext="{Binding Inventory}" />
            </DockPanel>
          </Panel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>
