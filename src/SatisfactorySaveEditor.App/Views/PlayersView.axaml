<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SatisfactorySaveEditor.App.ViewModels.Players"
             xmlns:views="using:SatisfactorySaveEditor.App.Views"
             x:Class="SatisfactorySaveEditor.App.Views.PlayersView"
             x:DataType="vm:PlayersViewModel">

  <Grid ColumnDefinitions="260,4,*" Margin="8">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Players" Classes="heading" Margin="0,0,0,6" />
      <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Names are not stored in saves; players are shown by platform id." />
      <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PlayerViewModel">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

    <Panel Grid.Column="2" Margin="8,0,0,0" IsVisible="{Binding SelectedPlayer, Converter={x:Static ObjectConverters.IsNotNull}}">
      <views:PlayerView DataContext="{Binding SelectedPlayer}" />
    </Panel>
  </Grid>
</UserControl>
