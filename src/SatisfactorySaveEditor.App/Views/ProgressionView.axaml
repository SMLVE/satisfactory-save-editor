<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SatisfactorySaveEditor.App.ViewModels.Progression"
             x:Class="SatisfactorySaveEditor.App.Views.ProgressionView"
             x:DataType="vm:ProgressionViewModel">

  <Grid ColumnDefinitions="*,4,360" Margin="8">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,6">
        <TextBlock Text="{Binding Summary}" Classes="heading" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasGameData}">
          <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedFilter}" MinWidth="180" />
          <TextBox Text="{Binding SearchText}" Watermark="Search schematics…" Width="260" />
          <Button Content="Unlock checked" Command="{Binding UnlockCheckedCommand}" />
          <Button Content="Unlock all shown" Command="{Binding UnlockAllShownCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding Error}" Classes="error"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <ListBox ItemsSource="{Binding Rows}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SchematicRow">
            <Grid ColumnDefinitions="Auto,*,90,70,90">
              <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding TierText}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="Purchased" Foreground="#107C10" VerticalAlignment="Center"
                         IsVisible="{Binding IsPurchased}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

    <DockPanel Grid.Column="2" Margin="8,0,0,0">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12" IsEnabled="{Binding HasGameData}">
        <TextBlock Text="Slots" Classes="heading" />
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="6">
          <TextBlock Text="Inventory" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Value="{Binding InventorySlots}" Minimum="1" Maximum="500" Increment="1" FormatString="0" />
          <TextBlock Grid.Row="1" Text="Hand slots" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding HandSlots}" Minimum="1" Maximum="10" Increment="1" FormatString="0" />
        </Grid>
        <Button Content="Apply slots" Command="{Binding ApplySlotsCommand}" HorizontalAlignment="Right" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Resizes every player's inventory. Shrinking only removes empty slots." />
      </StackPanel>

      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
        <TextBlock Text="AWESOME Sink" Classes="heading" />
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Text="Points" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Value="{Binding SinkPoints}" Minimum="0" Maximum="9000000000000000000" Increment="1000" FormatString="N0" />
          <TextBlock Grid.Row="1" Text="DNA points" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SinkDnaPoints}" Minimum="0" Maximum="9000000000000000000" Increment="1000" FormatString="N0" />
          <TextBlock Grid.Row="2" Text="Coupons to print" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SinkCoupons}" Minimum="0" Maximum="2000000000" Increment="1" FormatString="0" />
        </Grid>
        <Button Content="Apply sink" Command="{Binding ApplySinkCommand}" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding SinkLevels}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Coupons to print are collected at the AWESOME Sink. Raising points makes the game award the coupons for the levels crossed." />
      </StackPanel>

      <TextBlock DockPanel.Dock="Top" Text="Log" Classes="heading" Margin="0,0,0,6" />
      <ListBox ItemsSource="{Binding Log}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
